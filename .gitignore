# ======================================================================
# MediCore HMS — Git Ignore Rules (Full-Stack Frontend & Backend)
# ======================================================================

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Frontend Node & Build Artifacts ---
node_modules/
dist/
dist-ssr/
.oxlint-cache/

# --- Environment Configurations ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Ensure example templates are always tracked
!.env.example
!backend/.env.example

# --- Java & Maven Build Output ---
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper and caches
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- IDE & Editor Settings ---
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/
bin/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Windows & Visual Studio artifacts ---
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Documents & Binary Docs ---
*.pdf

